---
import { getCollection } from 'astro:content';
import PaperCard from './PaperCard.astro';

const papers = await getCollection('papers');
---

<section id="papers" class="papers" aria-labelledby="papers-title">
  <div class="container">
    <h2 id="papers-title" class="section-title">Research Papers</h2>
    <div class="papers-grid">
      {papers.map((entry) => <PaperCard entry={entry} />)}
    </div>
  </div>
</section>

<style>
  .papers {
    padding: var(--space-5xl) 0;
    background: var(--color-background);
  }

  .papers-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .papers-grid {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/scroll-reveal';

  revealOnScroll('#papers-title');
</script>
