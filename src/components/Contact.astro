---
import { Icon } from 'astro-icon/components';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title" class="section-title">Let's Connect</h2>
    <div class="contact-content">
      <p class="contact-description">
        I'm always interested in new opportunities and collaborations.
        Feel free to reach out if you'd like to discuss a project or just say hello!
      </p>
      <div class="contact-links">
        <a href="https://www.linkedin.com/in/robin-labryga/" class="contact-link" target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-brands:linkedin" class="contact-icon" aria-hidden="true" />
          LinkedIn
        </a>
        <a href="https://twitter.com/RobinLabryga" class="contact-link" target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-brands:twitter" class="contact-icon" aria-hidden="true" />
          Twitter
        </a>
        <a href="https://github.com/RobinLabryga" class="contact-link" target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-brands:github" class="contact-icon" aria-hidden="true" />
          GitHub
        </a>
        <a href="https://gitlab.com/robin.labryga" class="contact-link" target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-brands:gitlab" class="contact-icon" aria-hidden="true" />
          GitLab
        </a>
        <a href="mailto:robin.labryga@uni-hamburg.de" class="contact-link">
          <Icon name="fa6-regular:envelope" class="contact-icon" aria-hidden="true" />
          Email
        </a>
      </div>
    </div>
  </div>
</section>
