---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'papers'>;
}

const { entry } = Astro.props;
const { title, authors, year, status, keywords } = entry.data;
const { Content } = await render(entry);
---

<article class="paper-card">
  <div class="paper-content">
    <h3 class="paper-title">{title}</h3>
    <div class="paper-authors">
      {authors.map((author) => (
        <a href={author.url} class="paper-author">{author.name}</a>
      ))}
    </div>
    <p class="paper-description">
      <Content />
    </p>
    <div class="paper-meta">
      <span class="paper-year">{year}</span>
      {status.map((s) => <span class="paper-status">{s}</span>)}
      <div class="paper-keywords">
        {keywords.map((keyword) => (
          <span class="keyword-tag">{keyword}</span>
        ))}
      </div>
    </div>
    <div class="paper-links">
      <a href={`/papers/${entry.id}/`} class="paper-link">Read Paper</a>
    </div>
  </div>
</article>
