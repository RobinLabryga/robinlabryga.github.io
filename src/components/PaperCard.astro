---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'papers'>;
}

const { entry } = Astro.props;
const { title, authors, year, status, keywords } = entry.data;
const { Content } = await render(entry);
---

<article class="paper-card">
  <div class="paper-content">
    <h3 class="paper-title">{title}</h3>
    <div class="paper-authors">
      {
        authors.map((author) => (
          <a href={author.url} class="paper-author">
            {author.name}
          </a>
        ))
      }
    </div>
    <div class="paper-description">
      <Content />
    </div>
    <div class="paper-meta">
      <span class="paper-year">{year}</span>
      {status.map((s) => <span class="paper-status">{s}</span>)}
      <div class="paper-keywords">
        {keywords.map((keyword) => <span class="keyword-tag">{keyword}</span>)}
      </div>
    </div>
    <div class="paper-links">
      <a href={`/papers/${entry.id}/`} class="paper-link" data-astro-reload
        >Read Paper</a
      >
    </div>
  </div>
</article>

<style>
  .paper-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-normal);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .paper-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .paper-content {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .paper-title {
    margin-bottom: var(--space-md);
    color: var(--color-text);
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .paper-description {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    line-height: var(--line-height-relaxed);
    flex-grow: 1;
  }

  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .paper-year,
  .paper-status {
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-background);
    color: var(--color-text);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    border: 1px solid var(--color-border);
  }

  .paper-status {
    background: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
  }

  .paper-authors {
    display: flex;
    gap: var(--space-md);
  }

  .paper-author {
    color: var(--color-primary);
    font-weight: 500;
    padding: var(--space-sm) 0;
    border-bottom: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .paper-author:hover {
    border-bottom-color: var(--color-primary);
  }

  .paper-links {
    display: flex;
    gap: var(--space-md);
  }

  .paper-link {
    color: var(--color-primary);
    font-weight: 500;
    padding: var(--space-sm) 0;
    border-bottom: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .paper-link:hover {
    border-bottom-color: var(--color-primary);
  }

  .paper-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    width: 100%;
  }

  .keyword-tag {
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
    font-size: var(--font-size-xs);
    font-weight: 400;
    border: 1px solid var(--color-border-light);
    transition: all var(--transition-fast);
  }

  .keyword-tag:hover {
    color: var(--color-text);
    border-color: var(--color-border);
    background: var(--color-background);
  }
</style>
